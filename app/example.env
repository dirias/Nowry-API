GROQ_API_KEY=
GROQ_MODEL=

# Minutes the RSS feed cache is held. Matches the frontend's React Query
# staleTime in nowry/src/hooks/useNews.js; default 15 when unset.
NEWS_CACHE=15

ENV=development
# Extra origins on top of the built-in defaults in app/main.py
# (localhost, nowry.app, www.nowry.app, dev.nowry.app, www.dev.nowry.app)
ALLOWED_ORIGINS=
# Optional: a regex for Vercel previews, ending in the team's own scope (QA-004)
# e.g. https://nowry-[a-z0-9-]+-<team>\.vercel\.app — unset means no previews
ALLOWED_ORIGIN_REGEX=
# Proxies in front of the API; X-Forwarded-For is read this many entries from
# the right for rate limiting. Railway's edge is 1; 0 trusts the socket peer.
TRUSTED_PROXY_HOPS=1
SECRET_KEY=change_this_secret_in_production

MONGO_URI=mongodb://root:example@localhost:27017/
MONGO_DB=nowry-db

# Official curated content (ADR-004)
# Mongo user _id of the Nowry account that publishes official seed decks —
# the same value stored in decks.user_id. Leave blank outside production:
# curated browse then returns an empty page and nothing can be marked official.
OFFICIAL_PUBLISHER_USER_ID=
# Publisher display name shown on the official mark (defaults to "Nowry").
OFFICIAL_PUBLISHER_NAME=

# Cloudinary Configuration (Image Upload)
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Storage Backend (cloudinary or s3)
STORAGE_BACKEND=cloudinary

#Firebase

FIREBASE_SERVICE_ACCOUNT_PATH=

#stripe

STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE                                                                               
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
                                                                                                                        
STRIPE_PLUS_MONTHLY_PRICE_ID=price_XXXXX                                                                              
STRIPE_PLUS_ANNUAL_PRICE_ID=price_XXXXX      
STRIPE_PRO_MONTHLY_PRICE_ID=price_XXXXX                                                                               
STRIPE_PRO_ANNUAL_PRICE_ID=price_XXXXX

# --- Langfuse Configuration (Observability & Tracing) ---
# Get these from: https://cloud.langfuse.com/settings
LANGFUSE_SECRET_KEY=sk_lf_your_secret_key_here
LANGFUSE_PUBLIC_KEY=pk_lf_your_public_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Email (Resend) ---
# Operator notices, GTM-007: all three or nothing is sent.
RESEND_API_KEY=
NOTIFY_TO_EMAIL=
NOTIFY_FROM_EMAIL=
# Email to people, ADR-078. Without RESEND_API_KEY and the sender a kind needs,
# nothing is sent and the caller falls back to Firebase's own email.
# e.g. "Nowry <account@nowry.app>" and support@nowry.app
EMAIL_FROM_ACCOUNT=
EMAIL_REPLY_TO=
# e.g. "Didier from Nowry <hello@nowry.app>" (letters to visitors, WAIT-004 onward)
EMAIL_FROM_PERSONAL=
# A footer line; absent from every email while empty.
EMAIL_POSTAL_ADDRESS=
# Sends a day this environment may make (production 90, development 10: one
# Resend account, 100 a day, serves both). Default 90.
EMAIL_DAILY_BUDGET=
# Development only: addresses or @domains that may be written to, comma-separated.
# Unset means anyone (production).
EMAIL_ALLOWLIST=
# The Firebase project's web API key (public, the one the clients use). Lets the
# API ask Firebase for its own reset email when Resend cannot send.
FIREBASE_WEB_API_KEY=
# Where email links point, e.g. https://nowry.app
FRONTEND_URL=
# The mark image in emails. Must be a public PNG: mail providers fetch it from
# their own servers. Unset uses production's, https://www.nowry.app/logo192.png
EMAIL_MARK_URL=
