GROQ_API_KEY=
GROQ_MODEL=

NEWS_CACHE=

ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
SECRET_KEY=change_this_secret_in_production

MONGO_URI=mongodb://root:example@localhost:27017/
MONGO_DB=nowry-db

# Cloudinary Configuration (Image Upload)
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Storage Backend (cloudinary or s3)
STORAGE_BACKEND=cloudinary

#Firebase

FIREBASE_SERVICE_ACCOUNT_PATH=

#stripe

STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE                                                                               
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
                                                                                                                        
STRIPE_PLUS_MONTHLY_PRICE_ID=price_XXXXX                                                                              
STRIPE_PLUS_ANNUAL_PRICE_ID=price_XXXXX      
STRIPE_PRO_MONTHLY_PRICE_ID=price_XXXXX                                                                               
STRIPE_PRO_ANNUAL_PRICE_ID=price_XXXXX

# --- Langfuse Configuration (Observability & Tracing) ---
# Get these from: https://cloud.langfuse.com/settings
LANGFUSE_SECRET_KEY=sk_lf_your_secret_key_here
LANGFUSE_PUBLIC_KEY=pk_lf_your_public_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com