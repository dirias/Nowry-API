# Nowry API — environment variables
#
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; this file must contain PLACEHOLDERS ONLY — never real secrets.
#
# Loaded via python-dotenv (load_dotenv() in app/main.py, app/config/auth_config.py,
# app/config/firebase_config.py).
#
# Every variable below is read somewhere under app/ via os.getenv / os.environ.
# Variables marked OPTIONAL have a code-level default or a documented degraded mode;
# the app imports and boots without them.


# ---------------------------------------------------------------------------
# Database (app/config/database.py)
# ---------------------------------------------------------------------------
# OPTIONAL — defaults to mongodb://root:example@mongodb:27017/
MONGO_URI=mongodb://root:example@localhost:27017/
# OPTIONAL — defaults to "mydb"
MONGO_DB=nowry


# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Free tier — Groq / Llama 3.3 70B (app/core/model_config.py).
# OPTIONAL: if unset, model_config logs a warning and the Free-tier client is None;
# routes that need it return HTTP 503 "AI service unavailable. API key not configured."
GROQ_API_KEY=your-groq-api-key

# OPTIONAL — defaults to "llama-3.3-70b-versatile"
GROQ_MODEL=llama-3.3-70b-versatile

# OPTIONAL — intent-classification model override (app/utils/agent_llm.py).
# Falls back to GROQ_MODEL when unset.
GROQ_INTENT_MODEL=

# Plus + Pro tiers — Gemini Flash / Gemini Pro (app/core/model_config.py).
# OPTIONAL: if unset, model_config logs a warning and the Gemini clients are None;
# routes that need them (including /goal-ai/analyze) return HTTP 503.
GEMINI_API_KEY=your-gemini-api-key


# ---------------------------------------------------------------------------
# Langfuse — LLM tracing + prompt management (app/core/langfuse_client.py)
# ---------------------------------------------------------------------------
# OPTIONAL: if LANGFUSE_SECRET_KEY is unset, tracing is disabled and prompt
# management falls back to local prompts. The app runs normally.
LANGFUSE_SECRET_KEY=sk-lf-your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
# OPTIONAL — defaults to https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com


# ---------------------------------------------------------------------------
# Firebase Auth (app/config/firebase_config.py)
# ---------------------------------------------------------------------------
# Provide EITHER the inline service-account JSON or a path to the JSON file.
# If neither is set, the Admin SDK falls back to default credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json


# ---------------------------------------------------------------------------
# Stripe billing (app/routers/subscriptions.py, app/routers/stripe_webhooks.py,
#                 app/auth/firebase_auth.py)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
STRIPE_PLUS_MONTHLY_PRICE_ID=price_your-plus-monthly-id
STRIPE_PLUS_ANNUAL_PRICE_ID=price_your-plus-annual-id
STRIPE_PRO_MONTHLY_PRICE_ID=price_your-pro-monthly-id
STRIPE_PRO_ANNUAL_PRICE_ID=price_your-pro-annual-id


# ---------------------------------------------------------------------------
# Media storage (app/routers/image_upload.py, app/routers/agent.py)
# ---------------------------------------------------------------------------
# OPTIONAL — defaults to "cloudinary"
STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret


# ---------------------------------------------------------------------------
# Other integrations
# ---------------------------------------------------------------------------
# Google Cloud Text-to-Speech — provide the API key or the inline credentials JSON.
GOOGLE_TTS_API_KEY=your-google-tts-api-key
GOOGLE_TTS_CREDENTIALS_JSON=

# fal.ai — image generation
FAL_KEY=your-fal-api-key

# Sentry error reporting (app/main.py). OPTIONAL: unset disables Sentry.
SENTRY_DSN=


# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
# OPTIONAL — defaults to "development". Single canonical env signal, read via
# app/config/environment.py::is_production() / get_environment(). Set to
# "production" to: enable Secure cookies (app/config/auth_config.py), lower
# the Sentry trace sample rate and tag the Sentry environment (app/main.py),
# and require SECRET_KEY to be set (see below). Do NOT reintroduce a separate
# ENVIRONMENT var — everything reads ENV through the shared accessor.
ENV=development

# REQUIRED in production — session/JWT signing key (app/config/auth_config.py).
# The app refuses to start in production (ENV=production) if this is unset.
# In non-production environments only, an obviously-dev-only fallback is used
# (with a logged warning) purely for local dev convenience.
# Generate a real value with: openssl rand -hex 32
SECRET_KEY=

# OPTIONAL — CORS / Stripe redirect origin. Defaults to http://localhost:3000
FRONTEND_URL=http://localhost:3000

# OPTIONAL — news cache TTL in minutes (app/routers/news.py). Defaults to 5.
NEWS_CACHE=5
